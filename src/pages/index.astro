---
import { getCollection } from 'astro:content';
import { codeToHtml } from 'shiki';
import PageLayout from '../layouts/PageLayout.astro';

const blogPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projectsPosts = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const snippets = await getCollection('snippets');

const featuredBlog = blogPosts.find(p => p.data.featured);
const recentBlog = blogPosts.slice(0, 4);
const featuredProjects = projectsPosts.find(p => p.data.featured);
const featuredSnippets = snippets.slice(0, 4);

const codeExample = `// Nod 
struct Node {
    void* data;
    atomic_uintptr_t next;
};

void enqueue(Queue* q, void* data) {
    Node* n = malloc(sizeof(Node));
    n->data = data;
    atomic_store(&n->next, 0);
    
    // Swap tail
    Node* prev = atomic_exchange(&q->tail, n);
    atomic_store(&prev->next, (uintptr_t)n);
}`;

const highlightedCode = await codeToHtml(codeExample, {
  lang: 'c',
  theme: 'vitesse-dark',
});
---

<PageLayout title="masashi's orchard" activePage="home">
  <div class="max-w-4xl mx-auto px-6 lg:px-10 py-8 lg:py-12">
    <section class="mb-16 lg:mb-24 animate-fade-up stagger-1">
      <p class="text-fg-muted text-sm uppercase tracking-widest mb-4 font-mono"> compiler stuff / optimization experiments / opinions</p>
      <h2 class="font-display text-4xl lg:text-6xl font-semibold leading-tight mb-6">
        Meow!
        <span class="text-accent">I'm Masashi</span>
      </h2>
      <p class="text-fg-muted text-lg lg:text-xl leading-relaxed max-w-2xl">
      I share my thoughts, progress, findings, opinions and some random stuff here. Mostly PLDev or some low level stuff. 
      </p>
    </section>
    
    <section class="mb-16 lg:mb-24 animate-fade-up stagger-2">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-accent"></span>
        <span class="text-xs uppercase tracking-widest text-fg-subtle">Featured</span>
      </div>
      
      <article class="group relative bg-bg-elevated border border-border rounded-xl p-6 lg:p-8 hover:border-accent/50 transition-all duration-300 cursor-pointer">
        <div class="relative">
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2 py-1 text-xs font-mono text-accent rounded">zig</span>
            <span class="text-fg-subtle text-sm font-mono">67 min read</span>
          </div>
          
          <a href="/blog/zig-did-what" class="font-display text-2xl lg:text-3xl font-semibold mb-3 group-hover:text-accent transition-colors">
            Zig did WHAT? 
          </a>
          
          <p class="text-fg-muted leading-relaxed mb-4">
            Zig's latest version adds a thingamagic which ensures memory safety.
            Any segfaults after this are the OS's fault.
          </p>
          
          <div class="flex flex-row items-center gap-4 text-sm text-fg-subtle">
            <span datetime="2026-03-14">March 14, 2026</span>
            <span class="w-1 h-1 rounded-full bg-fg-subtle"></span>
            <span>in compilers</span>
          </div>
        </div>
      </article>
    </section>
    
    <section class="mb-16 lg:mb-24 animate-fade-up stagger-3">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-border"></span>
        <span class="text-xs uppercase tracking-widest text-fg-subtle">Recent Writing</span>
      </div>
      
      <div class="grid gap-4">
        {recentBlog.map((post) => (
          <a href={`/blog/${post.id}`} class="group items-start gap-4 p-4 rounded-lg hover:bg-bg-elevated transition-colors block">
            <time class="font-mono text-fg-subtle text-sm shrink-0 w-24">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace('/', '.')}
            </time>
            <div class="flex-1 min-w-0">
              <h4 class="font-display text-lg font-medium group-hover:text-accent transition-colors truncate">
                {post.data.title}
              </h4>
              <p class="text-fg-muted text-sm mt-1 line-clamp-1">
                {post.data.description}
              </p>
            </div>
            <span class="px-2 py-0.5 text-xs font-mono bg-border-subtle text-fg-muted rounded shrink-0">{post.data.tags[0]}</span>
          </a>
        ))}
      </div>
      
      <a href="/blog" class="inline-flex items-center gap-2 mt-6 text-sm text-fg-muted hover:text-accent transition-colors group">
        <span>view all posts</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </section>
    
    <section class="mb-16 lg:mb-24 animate-fade-up stagger-4">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-border"></span>
        <span class="text-xs uppercase tracking-widest text-fg-subtle">From the Kitchen</span>
      </div>
      
      <div class="code-block">
        <div class="code-header">
          <div class="code-dot border-red-400"></div>
          <div class="code-dot border-yellow-400"></div>
          <div class="code-dot border-green-400"></div>
          <span class="ml-2 text-xs font-mono text-fg-subtle">lockfree_queue.c</span>
        </div>
        <pre class="p-4 overflow-x-auto font-mono text-sm leading-relaxed" set:html={highlightedCode}></pre>
      </div>
      
      <p class="text-fg-muted text-sm mt-4 leading-relaxed">
        Excerpt from an upcoming deep-dive on lock-free data structures. 
        The memory ordering constraints are where things get... interesting.
      </p>
    </section>
    
    <section class="mb-16 lg:mb-24 animate-fade-up stagger-5">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-border"></span>
        <span class="text-xs uppercase tracking-widest text-fg-subtle">Snippets</span>
      </div>
      
      <input 
        type="text" 
        id="snippet-search"
        placeholder="Search snippets..." 
        class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-fg font-mono text-sm focus:outline-none focus:border-accent transition-colors"
      />
      
      <div id="snippet-results" class="grid gap-3 mt-4">
        {featuredSnippets.map((snippet) => (
          <a href={`/snippets/${snippet.id}`} class="snippet-item p-4 bg-bg-elevated border border-border rounded-lg hover:border-accent/50 transition-colors" data-title={snippet.data.title.toLowerCase()} data-description={snippet.data.description.toLowerCase()} data-tags={snippet.data.tags.join(' ').toLowerCase()}>
            <h4 class="font-display text-base font-medium mb-1">{snippet.data.title}</h4>
            <p class="text-fg-muted text-sm">{snippet.data.description}</p>
            <div class="flex gap-2 mt-2">
              {snippet.data.tags.map((tag) => (
                <span class="px-2 py-0.5 text-xs font-mono bg-border-subtle text-fg-muted rounded">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
      
      <a href="/snippets" class="inline-flex items-center gap-2 mt-6 text-sm text-fg-muted hover:text-accent transition-colors group">
        <span>view all snippets</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </section>
    
    <section class="animate-fade-up stagger-6">
      <div class="border-t border-border pt-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h4 class="font-display text-lg font-semibold mb-3">About</h4>
            <p class="text-fg-muted text-sm leading-relaxed">
              I'm Masashi. I try to build compilers and make everything run fast.

            </p>
          </div>
          
          <div>
            <h4 class="font-display text-lg font-semibold mb-3">Colophon</h4>
            <p class="text-fg-muted text-sm leading-relaxed">
              Built with Astro (and some coffee). 
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
  
  <script>
    console.log('Snippet search script loaded');
    
    function initSearch() {
      const searchInput = document.getElementById('snippet-search');
      const snippetItems = document.querySelectorAll('.snippet-item');
      
      console.log('searchInput:', searchInput);
      console.log('snippetItems:', snippetItems.length);
      
      function fuzzyMatch(str, pattern) {
        let si = 0, pi = 0;
        while (si < str.length && pi < pattern.length) {
          if (str[si] === pattern[pi]) pi++;
          si++;
        }
        return pi === pattern.length;
      }
      
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase();
          console.log('Search query:', query);
          
          snippetItems.forEach((item) => {
            const title = item.getAttribute('data-title') || '';
            const description = item.getAttribute('data-description') || '';
            const tags = item.getAttribute('data-tags') || '';
            
            if (query === '' || fuzzyMatch(title, query) || fuzzyMatch(description, query) || fuzzyMatch(tags, query)) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
    
    document.addEventListener('astro:page-load', initSearch);
  </script>
</PageLayout>
