---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts.find(p => p.data.featured);
const otherPosts = posts.filter(p => !p.data.featured);
---

<PageLayout 
  title="Projects | masashi's orchard" 
  description="masashi's serial experiments"
  activePage="projects"
>
  <div class="max-w-4xl mx-auto px-6 lg:px-10 py-8 lg:py-12">
    <section class="mb-12 animate-fade-up">
      <p class="text-fg-muted text-sm uppercase tracking-widest mb-4 font-mono">Projects</p>
      <h2 class="font-display text-4xl lg:text-6xl font-semibold leading-tight mb-4">
        Projects &
        <span class="text-accent">experiments</span>
      </h2>
      <p class="text-fg-muted text-lg max-w-2xl">
        You'll find a ton of fun stuff here. 
      </p>
    </section>
    
    {featuredPost && (
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-accent"></span>
          <span class="text-xs uppercase tracking-widest text-fg-subtle">Featured</span>
        </div>
        
        <a href={`/projects/${featuredPost.id}`} class="group relative bg-bg-elevated border border-border rounded-xl p-6 lg:p-8 hover:border-accent/50 transition-all duration-300 block">
          <div class="flex items-center gap-3 mb-4">
            {featuredPost.data.tags.slice(0, 2).map((tag) => (
              <span class="px-2 py-1 text-xs font-mono text-accent rounded">{tag}</span>
            ))}
            <span class="text-fg-subtle text-sm font-mono">featured</span>
          </div>
          
          <h3 class="font-display text-2xl lg:text-3xl font-semibold mb-3 group-hover:text-accent transition-colors">
            {featuredPost.data.title}
          </h3>
          
          <p class="text-fg-muted leading-relaxed mb-4">
            {featuredPost.data.description}
          </p>
          
          <div class="flex flex-row items-center gap-4 text-sm text-fg-subtle">
            <time datetime={featuredPost.data.pubDate.toISOString()}>
              {featuredPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
        </a>
      </section>
    )}
    
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px bg-border"></span>
        <span class="text-xs uppercase tracking-widest text-fg-subtle">All Snippets</span>
      </div>
      
      <div class="grid gap-4">
        {otherPosts.map((post) => (
          <a href={`/projects/${post.id}`} class="group items-start gap-4 p-4 rounded-lg hover:bg-bg-elevated transition-colors block">
            <time class="font-mono text-fg-subtle text-sm shrink-0 w-24">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace('/', '.')}
            </time>
            <div class="flex-1 min-w-0">
              <h4 class="font-display text-lg font-medium group-hover:text-accent transition-colors truncate">
                {post.data.title}
              </h4>
              <p class="text-fg-muted text-sm mt-1 line-clamp-1">
                {post.data.description}
              </p>
            </div>
            <div class="flex gap-2 shrink-0">
              {post.data.tags.slice(0, 1).map((tag) => (
                <span class="px-2 py-0.5 text-xs font-mono bg-border-subtle text-fg-muted rounded">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
