---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  activePage?: 'home' | 'blog' | 'projects';
}

const { 
  title, 
  description = "Masshi's digital garden. PLDev and stuff",
  activePage = 'home'
} = Astro.props;

const navItems = [
  { href: '/blog', label: 'writing', page: 'blog' },
  { href: '/projects', label: 'projects', page: 'projects' },
  // { href: '', label: 'about', page: 'about' },
] as const;

const sidebarItems = [
  { href: '/', label: 'home', icon: 'home.svg', page: 'home' },
  { href: '/blog', label: 'blog', icon: 'file-minus.svg', page: 'blog' },
  { href: '/projects', label: 'projects', icon: 'code.svg', page: 'projects' },
  { href: '/snippets', label: 'snippets', icon: 'hash.svg', page: 'snippets' },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>

  <body class="min-h-screen overflow-x-hidden font-sans" style="background-color: var(--bg); color: var(--fg); font-family: 'Satoshi', sans-serif;">
    <header class="h-[6.5vh] border-b border-border flex items-center justify-between px-6 lg:px-10 animate-fade-in">
      <div class="flex items-center gap-3">
        <h1 class="font-display pl-11 text-xl lg:text-2xl font-semibold tracking-tight">
          {activePage === 'home' ? (
            "masashi's orchard"
          ) : (
            <a href="/">masashi's orchard</a>
          )}
        </h1>
      </div>
      
      <nav class="hidden md:flex items-center gap-8 text-sm">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class={`text-fg-muted hover:text-fg transition-colors duration-200 relative group ${activePage === item.page ? 'text-fg' : ''}`}
          >
            {item.label}
            <span class={`absolute -bottom-1 left-0 h-px bg-accent transition-all duration-300 ${activePage === item.page ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
          </a>
        ))}
      </nav>
      
      <button id="sidebar-toggle" class="md:hidden w-8 h-8 flex items-center justify-center text-fg-muted hover:text-fg transition-colors" aria-label="Toggle sidebar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </header>
    
    <main class="flex flex-row w-full h-[calc(100vh-6.5vh)]">
      <aside id="sidebar" class="w-16 lg:w-20 border-r border-border flex flex-col items-center py-6 gap-6 transition-all duration-300 bg-bg-elevated/50">
        {sidebarItems.map((item) => (
          <a 
            href={item.href} 
            class={`nav-item w-10 h-10 rounded-lg flex items-center justify-center text-fg-muted hover:text-fg hover:bg-border-subtle transition-all duration-200 group relative ${activePage === item.page ? 'text-fg' : ''}`}
            aria-label={item.label}
          >
            <img src={`/${item.icon}`} width="20" height="20" alt="" class="nav-icon transition-all" />
            <span class="sidebar-tooltip absolute left-full ml-2 px-2 py-1 bg-bg-elevated border border-border rounded text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10">
              {item.label}
            </span>
            {activePage === item.page && (
              <span class="absolute left-0 w-0.5 h-6 bg-accent rounded-r transition-all group-hover:w-0.5"></span>
            )}
          </a>
        ))}
        
        <div class="flex-1"></div>
        
        <button class="theme-toggle w-10 h-10 rounded-lg flex items-center justify-center text-fg-muted hover:text-fg hover:bg-border-subtle transition-all duration-200 group relative" aria-label="Theme">
          <img src="/sun.svg" width="20" height="20" alt="" class="theme-icon-sun nav-icon" />
          <img src="/moon.svg" width="20" height="20" alt="" class="theme-icon-moon nav-icon hidden transition-all" />
          <span class="sidebar-tooltip absolute left-full ml-2 px-2 py-1 bg-bg-elevated border border-border rounded text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10">
            theme
          </span>
        </button>
      </aside>
      
      <div class="flex-1 overflow-y-auto">
        <slot />
      </div>
    </main>
    
    <script>
      document.querySelectorAll('.nav-item').forEach(item => {
        const isActive = item.querySelector('span:last-child');
        if (isActive && !(item.querySelector('.sidebar-tooltip'))) {
          const indicator = item.querySelector('span:last-child');
          if (indicator) {
            indicator.classList.add('w-0.5', 'h-6');
          }
        }
      });
      
      const sidebarToggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      let sidebarOpen = false;
      
      sidebarToggle?.addEventListener('click', () => {
        sidebarOpen = !sidebarOpen;
        if (sidebarOpen) {
          sidebar.classList.remove('w-16', 'lg:w-20');
          sidebar.classList.add('w-48');
        } else {
          sidebar.classList.remove('w-48');
          sidebar.classList.add('w-16', 'lg:w-20');
        }
      });
      
      const themeBtn = document.querySelector('.theme-toggle');
      const themeIconSun = document.querySelector('.theme-icon-sun');
      const themeIconMoon = document.querySelector('.theme-icon-moon');
      
      function updateThemeIcons() {
        const isLight = document.documentElement.classList.contains('light');
        if (isLight) {
          themeIconSun?.classList.add('hidden');
          themeIconMoon?.classList.remove('hidden');
        } else {
          themeIconSun?.classList.remove('hidden');
          themeIconMoon?.classList.add('hidden');
        }
      }
      
      updateThemeIcons();
      
      themeBtn?.addEventListener('click', () => {
        document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', document.documentElement.classList.contains('light') ? 'light' : 'dark');
        updateThemeIcons();
      });
    </script>
  </body>
</html>
